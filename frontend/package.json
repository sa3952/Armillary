{
  "name": "classical-astrology-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Lint and test tooling for the browser UI. Not a published package and not a runtime dependency: the frontend ships as plain <script> files with no bundler.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 zh-TW/*.js tests/*.cjs tests/e2e/*.cjs",
    "test": "node --test tests/*.test.cjs",
    "e2e": "playwright test --config tests/e2e/playwright.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.1"
  }
}
